# FastAPI backend image.
# Build: docker build -f Dockerfile.api -t interviewdna-api .
FROM python:3.11-slim

WORKDIR /app

# System deps needed by pymupdf / sentence-transformers wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download model weights AT BUILD TIME, not on the first real request.
# Without this, the first embedding call (~90MB) and the first reranker
# call (~80MB) each silently block for however long the download takes --
# this is the exact "backend unreachable / read timed out" failure mode we
# hit repeatedly in local dev, except in production it'd hit a real user's
# first request instead of a dev's first test click.
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')" \
    && python -c "from sentence_transformers import CrossEncoder; CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2')"

COPY . .

EXPOSE 8000

# Shell form (not exec/JSON array form) is required here so $PORT actually
# gets expanded -- most PaaS platforms (Render, Railway, Cloud Run) assign
# your app a port dynamically via the PORT env var and route traffic to
# whatever you bind to, rather than always using 8000. Falls back to 8000
# when PORT isn't set (e.g. local `docker compose up`, which doesn't set it).
CMD uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}
